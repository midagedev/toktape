{
  // The toktape hub: where a published run lives (docs/toktape-spec.ko.md §9).
  //
  // The Worker never parses a tape. The Go client derives a versioned index
  // row next to the schema and uploads it beside the record, so knowledge of
  // the tape's shape has exactly one owner — see the doc block on
  // publish.Client in internal/publish/client.go, which is the contract this
  // implements.
  "name": "toktape-hub",
  "main": "src/index.js",
  // The newest date the pinned workerd actually implements (1.20260917.1).
  // A date the local runtime cannot serve makes `wrangler dev` refuse to
  // start, which would mean the gate never runs against the runtime the
  // deploy uses — the one thing a local harness exists to avoid.
  "compatibility_date": "2026-09-17",
  "observability": { "enabled": true },

  "vars": {
    // The service's own name, and what a receipt's link is built from.
    //
    // Not derived from the request: `wrangler dev` simulates the configured
    // route, so a request to the dev server arrives claiming to be
    // tape.midagedev.com and a derived link would send a developer's own
    // publish to production. It is declared here and overridden with
    // `--var` where the service is not the one at this address.
    "PUBLIC_BASE_URL": "https://tape.midagedev.com",
    // Cloudflare Web Analytics for tape.midagedev.com, a site of its own so
    // the hub's figures are not mixed with the zone's other hosts. Public by
    // nature (it is printed in every page). Hosting your own hub: delete this
    // line and no page carries a beacon or the sentence about it
    // (src/analytics.js).
    "CF_BEACON_TOKEN": "89f8a44523b2461ca801e06bd4ed491e"
  },
  "routes": [
    {
      // A custom domain, not a route: the Worker owns the whole hostname and
      // Cloudflare manages the DNS record for it. midagedev.com has a
      // wildcard A record, so without an explicit record this name would
      // resolve to an unrelated host; the custom domain is what overrides it.
      "pattern": "tape.midagedev.com",
      "custom_domain": true
    }
  ],

  // The browser player, served as static assets under /player/: the wasm,
  // Go's wasm_exec.js and host.js, all written by web/player/build.sh. A
  // request for a path that is not in the directory falls through to the
  // Worker, so /r/<id> and the API are unaffected; a request for one that is
  // never reaches the Worker, which is what lets the wasm be sent with the
  // right content type and brotli without this code knowing about either.
  "assets": { "directory": "player/dist" },

  // R2 holds the record itself and, later, the PNG card. It is the original:
  // if the normalisation table turns out to be wrong, the index is re-derived
  // from what is here and nothing is lost (§9.4, rule 3).
  "r2_buckets": [
    { "binding": "TAPES", "bucket_name": "toktape" }
  ],

  // D1 holds the index rows and nothing a tape has to be opened to learn.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toktape",
      "database_id": "cbbf941e-cace-4cd4-b780-a8258ede5493",
      "migrations_dir": "migrations"
    }
  ]
}
