{
  "name": "toktape-hub",
  "private": true,
  "type": "module",
  "description": "The Cloudflare Worker behind tape.midagedev.com. The Worker never parses a tape; see ../internal/publish/client.go.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply toktape --local",
    "migrate:remote": "wrangler d1 migrations apply toktape --remote"
  },
  "devDependencies": {
    "wrangler": "4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
