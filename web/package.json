{
  "name": "toktape-hub",
  "private": true,
  "type": "module",
  "description": "The Cloudflare Worker behind tape.midagedev.com. The Worker never parses a tape; see ../internal/publish/client.go.",
  "scripts": {
    "dev": "./player/build.sh && wrangler dev --var PUBLIC_BASE_URL:http://127.0.0.1:8787 --var RATE_SALT:local-dev-salt",
    "build:player": "./player/build.sh",
    "deploy": "./player/build.sh && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply toktape --local",
    "migrate:remote": "wrangler d1 migrations apply toktape --remote"
  },
  "devDependencies": {
    "wrangler": "^4.134.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260917.1": true
  }
}
